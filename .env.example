# 32 random bytes that encrypt stored Obsidian credentials at rest AND derive
# the session-signing secret. Must be real key material — base64 (44 chars) or
# hex (64 chars); a passphrase is NOT accepted.
# Generate with: openssl rand -base64 32   (or: openssl rand -hex 32)
ENCRYPTION_KEY=

# DATA_DIR is deliberately NOT listed here.
#
# Railway seeds a service's suggested variables from this file, and a relative
# path resolves against the container's WORKDIR (/app) rather than the mounted
# volume at /data — so suggesting `./data` puts the vault and database on the
# container's ephemeral layer, where a redeploy silently discards them. The
# Dockerfile already sets DATA_DIR=/data for production; locally the code
# defaults to ./data when the variable is unset (see src/server/env.ts).

# Public origin of this deployment, e.g. https://my-vault.up.railway.app
# Used for OAuth issuer/redirect URLs. Defaults to http://localhost:3000 in dev.
BASE_URL=http://localhost:3000
