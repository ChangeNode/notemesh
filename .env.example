# Random string that gates the first-boot setup wizard.
# The Railway template generates this automatically; copy it from the
# Railway dashboard when the setup page asks for it.
SETUP_TOKEN=change-me

# 32 random bytes, base64 — encrypts stored Obsidian credentials at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Where the vault, database, and ob CLI state live (a Railway volume in prod).
DATA_DIR=./data

# Public origin of this deployment, e.g. https://my-vault.up.railway.app
# Used for OAuth issuer/redirect URLs. Defaults to http://localhost:3000 in dev.
BASE_URL=http://localhost:3000
