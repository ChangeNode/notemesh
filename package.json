{
  "name": "notemesh",
  "version": "1.0.0",
  "description": "Personal Obsidian vault MCP server \u2014 Railway template",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build && node scripts/check-client-bundle.mjs",
    "check:client": "node scripts/check-client-bundle.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "start": "vinxi start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e scripts --max-warnings 0",
    "lint:fix": "eslint src e2e scripts --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.25",
    "@better-auth/oauth-provider": "1.6.25",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@picocss/pico": "^2.1.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.3.2",
    "better-auth": "1.6.25",
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "execa": "^10.0.0",
    "fetch-to-node": "^2.1.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.4",
    "obsidian-headless": "0.0.14",
    "solid-js": "^1.9.7",
    "vinxi": "^0.5.11",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.9.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ChangeNode (Will Iverson) <https://changenode.com/>",
  "license": "AGPL-3.0-or-later"
}
